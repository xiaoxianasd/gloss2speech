# ================== 华为云 MaaS（Qwen-VL 识别 + DeepSeek 造句） ==================
MAAS_BASE_URL=https://api.modelarts-maas.com/v1
MAAS_API_KEY=
MAAS_VL_MODEL=qwen2.5-vl-72b
MAAS_LLM_MODEL=deepseek-v3
# 默认关闭推理思考链，保障低延迟并避免 max_tokens 被思考过程耗尽；不支持该参数的模型可设为 0
MAAS_DISABLE_THINKING=1

# ================== 华为云 SIS（语音合成 / 语音识别） ==================
HW_AK=
HW_SK=
HW_PROJECT_ID=
SIS_REGION=cn-north-4
SIS_TTS_VOICE=chinese_xiaoyan_common
SIS_ASR_PROPERTY=chinese_16k_common

# ================== 运行模式 ==================
# auto：有密钥用真实服务，没密钥自动 Mock（默认，方便无密钥联调）
# 1：强制 Mock
# 0：强制真实（缺密钥直接报错，避免"以为在调云、其实在 Mock"）
MOCK_MODE=auto

# 视觉模型调用超时（秒）
VISION_TIMEOUT=15

# 默认场景
SCENE_DEFAULT=hospital

# ================== 公网防护（上公网前必须配置，见 backend/guard.py） ==================
# 访问口令：非空时前端所有 /api/* 请求必须携带；本地开发留空即关闭。
# 浏览器端首次访问会弹窗要求输入口令（存 localStorage），也可构建时用 VITE_API_TOKEN 注入。
API_TOKEN=
# 每客户端 IP 每分钟 /api/* 请求上限（0 = 关闭限流；Nginx 层另有 2r/s 限流双保险）
RATE_LIMIT_PER_MINUTE=120

# ================== 前端（可选） ==================
# 留空走同源 /api（开发走 Vite 代理、生产走 Nginx 反代）
VITE_API_BASE=
# 与 API_TOKEN 相同的口令（仅用于构建期注入；运行时弹窗输入优先）
VITE_API_TOKEN=
